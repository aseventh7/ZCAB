# ===== 德馨苑物业管理系统 - 后端环境配置 =====

# 服务端口
PORT=3000

# JWT 密钥（生产环境请改成随机长字符串）
JWT_SECRET=dxy-property-jwt-secret-2026-please-change-in-production
JWT_EXPIRES_IN=8h

# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据库类型：sqlite（开箱即用，无需安装） 或 mysql（生产/腾讯云）
DB_TYPE=sqlite

# ----- SQLite 配置（DB_TYPE=sqlite 时使用） -----
DB_SQLITE_PATH=./data/dxy-property.db

# ----- MySQL 配置（DB_TYPE=mysql 时使用，腾讯云部署时填这里） -----
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=dxy_property

# 跨域允许的前端地址（多个用逗号分隔）
CORS_ORIGIN=*
